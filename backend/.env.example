PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
# Development only. When true, login is skipped and every request is served as AUTH_BYPASS_EMAIL.
# The backend refuses to start with this enabled while NODE_ENV=production.
AUTH_BYPASS=false
AUTH_BYPASS_EMAIL=test@example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# Session pooler URI (port 5432) from Dashboard > Project Settings > Database.
# Only used by "npm run migrate"; the application itself never opens this connection.
SUPABASE_DB_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_STT_LANGUAGE=eng
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
