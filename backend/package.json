{
  "name": "@voice-chat/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate.ts",
    "lint": "eslint .",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "@voice-chat/shared": "1.0.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "nodemon": "3.1.9",
    "pg": "8.13.1",
    "tsx": "4.19.2",
    "typescript": "5.5.4"
  }
}
